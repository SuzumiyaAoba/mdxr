{
  "name": "@suzumiyaaoba/rv",
  "version": "0.1.0",
  "description": "Render agent-authored MDX documents (plans, reports) to standalone HTML with a semantic component catalog",
  "bin": {
    "rv": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components.d.mts",
      "default": "./dist/components.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "cac": "^7.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0",
    "valibot": "^1.5.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "storybook": "^10.6.0",
    "typescript": "^5.8.0",
    "ultracite": "7.11.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.2",
    "vite-plus": "^0.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
